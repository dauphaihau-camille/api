PORT=5100
LOG_LEVEL=info
LOG_PRETTY=true
NODE_ENV=development
TRUST_PROXY=true
REQUEST_BODY_LIMIT=5mb
CORS_ALLOWED_ORIGINS=http://localhost:5102,http://localhost:5101
APP_BASE_URL=http://localhost:5102
API_BASE_URL=http://localhost:5100

# Database
DB_HOST=127.0.0.1
DB_PORT=55433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app


# Cache
REDIS_URL=redis://127.0.0.1:56380
CACHE_DRIVER=redis
CACHE_TTL=60s


# Rate limiting
RATE_LIMIT_DRIVER=redis
RATE_LIMIT_LIMIT=120
RATE_LIMIT_TTL=60s
RATE_LIMIT_BLOCK_DURATION=60s


# Queue
QUEUE_DRIVER=redis
QUEUE_NAME=default
QUEUE_PREFIX=nest-template
QUEUE_REDIS_URL=redis://127.0.0.1:56380
QUEUE_JOB_ATTEMPTS=5
QUEUE_JOB_BACKOFF=5s
QUEUE_REMOVE_COMPLETED_AFTER=1d
QUEUE_REMOVE_FAILED_AFTER=7d
QUEUE_WORKER_CONCURRENCY=10

BULL_BOARD_ENABLED=true
BULL_BOARD_PATH=/ops/queues



# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

AUTH_COOKIE_ACCESS_NAME=accessToken
AUTH_COOKIE_REFRESH_NAME=refreshToken
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false

BCRYPT_SALT_ROUNDS=12



# Mail
MAIL_DRIVER=logger
MAIL_DEFAULT_FROM_EMAIL=noreply@example.com
MAIL_DEFAULT_FROM_NAME="Nest Template"
RESEND_API_KEY=



# AI assistant
AI_PROVIDER=noop
AI_FAKE_STREAM_DELAY_MS=40
AI_DEFAULT_TEXT_MODEL=openai:gpt-5.5
AI_DEFAULT_EMBEDDING_MODEL=openai:text-embedding-3-small
AI_EMBEDDING_MODELS='{"openai:text-embedding-3-small":{"provider":"openai","providerModel":"text-embedding-3-small"}}'
AI_DEFAULT_REASONING_EFFORT=low
AI_DEFAULT_MAX_TOKENS=1200
AI_ROUTER_TEXT_PROVIDERS=gemini,groq,openrouter
AI_ROUTER_EMBEDDING_PROVIDER=openai
AI_MODELS='{"openai:gpt-5.5":{"provider":"openai","providerModel":"gpt-5.5","maxTokens":1200,"openai":{"reasoningEffort":"low"}},"openai:gpt-5.5-mini":{"provider":"openai","providerModel":"gpt-5.5-mini","maxTokens":800,"openai":{"reasoningEffort":"minimal"}},"gemini:gemini-3.6-flash":{"provider":"gemini","providerModel":"gemini-3.6-flash","maxTokens":1200,"gemini":{}},"groq:openai/gpt-oss-20b":{"provider":"groq","providerModel":"openai/gpt-oss-20b","maxTokens":1200,"groq":{}},"openrouter:openai/gpt-oss-20b":{"provider":"openrouter","providerModel":"openai/gpt-oss-20b","maxTokens":1200,"openrouter":{}}}'

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_DEFAULT_TEXT_MODEL=gemini-3.6-flash

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_DEFAULT_TEXT_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_TEXT_MODEL=openai/gpt-oss-20b


# Payment
PAYMENT_DRIVER=noop
PAYMENT_PUBLIC_BASE_URL=http://localhost:5102
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SUCCESS_PATH=/payments/success
PAYMENT_CANCEL_PATH=/payments/cancel
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=


# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=
STORAGE_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:19002
STORAGE_OBJECT_STORAGE_REGION=us-east-1
STORAGE_OBJECT_STORAGE_BUCKET=app-files
STORAGE_OBJECT_STORAGE_ACCESS_KEY=minioadmin
STORAGE_OBJECT_STORAGE_SECRET_KEY=minioadmin
STORAGE_OBJECT_STORAGE_FORCE_PATH_STYLE=true



# Observability
OTEL_ENABLED=true
OTEL_SERVICE_NAME=camille-api
OTEL_TRACES_CONSOLE_EXPORTER=false
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14328
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

METRICS_BEARER_TOKEN=local-dev-metrics-token
