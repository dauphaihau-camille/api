PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true
NODE_ENV=development
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=http://localhost:3001
APP_BASE_URL=http://localhost:4000
API_BASE_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=55433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app

REDIS_URL=redis://127.0.0.1:56380
CACHE_DRIVER=redis
CACHE_TTL=60s

RATE_LIMIT_DRIVER=redis
RATE_LIMIT_LIMIT=20
RATE_LIMIT_TTL=60s
RATE_LIMIT_BLOCK_DURATION=60s

QUEUE_DRIVER=redis
QUEUE_NAME=default
QUEUE_PREFIX=nest-template
QUEUE_REDIS_URL=redis://127.0.0.1:56380
QUEUE_JOB_ATTEMPTS=5
QUEUE_JOB_BACKOFF=5s
QUEUE_REMOVE_COMPLETED_AFTER=1d
QUEUE_REMOVE_FAILED_AFTER=7d
QUEUE_WORKER_CONCURRENCY=10

BULL_BOARD_ENABLED=true
BULL_BOARD_PATH=/ops/queues

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d
AUTH_COOKIE_ACCESS_NAME=accessToken
AUTH_COOKIE_REFRESH_NAME=refreshToken
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false

BCRYPT_SALT_ROUNDS=12

MAIL_DRIVER=logger
MAIL_DEFAULT_FROM_EMAIL=noreply@example.com
MAIL_DEFAULT_FROM_NAME=Nest Template
RESEND_API_KEY=

AI_DEFAULT_TEXT_MODEL=general-text
AI_DEFAULT_EMBEDDING_MODEL=text-embedding

PAYMENT_PUBLIC_BASE_URL=http://localhost:3000
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SUCCESS_PATH=/payments/success
PAYMENT_CANCEL_PATH=/payments/cancel

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=
STORAGE_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:19002
STORAGE_OBJECT_STORAGE_REGION=us-east-1
STORAGE_OBJECT_STORAGE_BUCKET=app-files
STORAGE_OBJECT_STORAGE_ACCESS_KEY=minioadmin
STORAGE_OBJECT_STORAGE_SECRET_KEY=minioadmin
STORAGE_OBJECT_STORAGE_FORCE_PATH_STYLE=true

OTEL_ENABLED=true
OTEL_SERVICE_NAME=nest-template-api
OTEL_TRACES_CONSOLE_EXPORTER=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:14328/v1/traces
