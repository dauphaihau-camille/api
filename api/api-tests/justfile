set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

vars_file := "hurl.variables"
stdout_file := "/tmp/hurl.out"
stderr_file := "/tmp/hurl-verbose.out"
api_dir := ".."
generated_vars_file := "/tmp/camille-hurl.variables"

default:
  @just --list

suite:
  node scripts/generate-variables.mjs {{vars_file}} > {{generated_vars_file}}
  hurl --test --glob "**/*.hurl" --variables-file {{generated_vars_file}}

# -------------------- Seeding

db-seed:
  cd {{api_dir}} && pnpm db:seed

db-seed-demo:
  cd {{api_dir}} && pnpm db:seed:demo

db-fresh:
  cd {{api_dir}} && pnpm db:migration:up && pnpm db:seed

db-fresh-demo:
  cd {{api_dir}} && pnpm db:migration:up && pnpm db:seed:demo

run file:
  file_path="{{file}}"; \
  if [[ "$file_path" == api-tests/* ]]; then \
    file_path="${file_path#api-tests/}"; \
  fi; \
  node scripts/generate-variables.mjs {{vars_file}} > {{generated_vars_file}}; \
  set +e; \
  hurl --include --very-verbose --variables-file {{generated_vars_file}} "$file_path" > {{stdout_file}} 2> {{stderr_file}}; \
  status=$?; \
  set -e; \
  nu scripts/format-response.nu {{stdout_file}} {{stderr_file}}; \
  if [[ $status -ne 0 ]]; then \
    printf '\nHurl failure details\n'; \
    sed -n '/^error:/,$p' {{stderr_file}}; \
  fi; \
  exit $status
