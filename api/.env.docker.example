PORT=5100
LOG_LEVEL=info
LOG_PRETTY=false
NODE_ENV=development
TRUST_PROXY=true
REQUEST_BODY_LIMIT=5mb
CORS_ALLOWED_ORIGINS=http://localhost:5102,http://localhost:5101

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app

REDIS_URL=redis://redis:6379
CACHE_DRIVER=redis
CACHE_TTL=60s

RATE_LIMIT_DRIVER=redis
RATE_LIMIT_LIMIT=20
RATE_LIMIT_TTL=60s
RATE_LIMIT_BLOCK_DURATION=60s

QUEUE_DRIVER=redis
QUEUE_NAME=default
QUEUE_PREFIX=nest-template
QUEUE_REDIS_URL=redis://redis:6379
QUEUE_JOB_ATTEMPTS=5
QUEUE_JOB_BACKOFF=5s
QUEUE_REMOVE_COMPLETED_AFTER=1d
QUEUE_REMOVE_FAILED_AFTER=7d
QUEUE_WORKER_CONCURRENCY=10

BULL_BOARD_ENABLED=true
BULL_BOARD_PATH=/ops/queues

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d
AUTH_COOKIE_ACCESS_NAME=accessToken
AUTH_COOKIE_REFRESH_NAME=refreshToken
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false

BCRYPT_SALT_ROUNDS=12

MAIL_DRIVER=logger
MAIL_DEFAULT_FROM_EMAIL=noreply@example.com
MAIL_DEFAULT_FROM_NAME=Nest Template
RESEND_API_KEY=

AI_PROVIDER=noop
AI_FAKE_STREAM_DELAY_MS=40
AI_DEFAULT_TEXT_MODEL=openai:gpt-5.6
AI_DEFAULT_REASONING_EFFORT=low
AI_DEFAULT_MAX_TOKENS=1200
AI_MODELS='{"openai:gpt-5.6":{"provider":"openai","providerModel":"gpt-5.6","maxTokens":1200,"openai":{"reasoningEffort":"low"}},"openai:gpt-5.6-mini":{"provider":"openai","providerModel":"gpt-5.6-mini","maxTokens":800,"openai":{"reasoningEffort":"minimal"}}}'
AI_DEFAULT_EMBEDDING_MODEL=openai:text-embedding-3-small
AI_EMBEDDING_MODELS='{"openai:text-embedding-3-small":{"provider":"openai","providerModel":"text-embedding-3-small"}}'
OPENAI_API_KEY=
OPENAI_BASE_URL=

PAYMENT_PUBLIC_BASE_URL=http://localhost:5102
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SUCCESS_PATH=/payments/success
PAYMENT_CANCEL_PATH=/payments/cancel
METRICS_BEARER_TOKEN=local-dev-metrics-token

STORAGE_DRIVER=minio
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=
STORAGE_OBJECT_STORAGE_ENDPOINT=http://minio:9000
STORAGE_OBJECT_STORAGE_REGION=us-east-1
STORAGE_OBJECT_STORAGE_BUCKET=app-files
STORAGE_OBJECT_STORAGE_ACCESS_KEY=minioadmin
STORAGE_OBJECT_STORAGE_SECRET_KEY=minioadmin
STORAGE_OBJECT_STORAGE_FORCE_PATH_STYLE=true

OTEL_ENABLED=true
OTEL_SERVICE_NAME=camille-api
OTEL_TRACES_CONSOLE_EXPORTER=false
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
