{
  "name": "camille-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.3.0",
  "engines": {
    "node": ">=22 <23"
  },
  "volta": {
    "node": "22.0.0",
    "pnpm": "9.3.0"
  },
  "scripts": {
    "prepare": "cd .. && api/node_modules/.bin/husky",
    "build": "node ./node_modules/@nestjs/cli/bin/nest.js build && tsc-alias -p tsconfig.build.json",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "db:migration:create": "mikro-orm migration:create",
    "db:migration:down": "mikro-orm migration:down",
    "db:migration:up": "mikro-orm migration:up",
    "db:clear": "ts-node -r tsconfig-paths/register ./database/clear.ts",
    "db:seed": "ts-node -r tsconfig-paths/register ./database/seed-reference.ts",
    "db:seed:demo": "ts-node -r tsconfig-paths/register ./database/seed.ts",
    "db:seed:huge": "ts-node -r tsconfig-paths/register ./database/seed-huge.ts",
    "db:seed:realistic": "ts-node -r tsconfig-paths/register ./database/seed-realistic.ts",
    "format": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "start": "NODE_OPTIONS=\"--import ./instrumentation.mjs${NODE_OPTIONS:+ $NODE_OPTIONS}\" node -r tsconfig-paths/register ./node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "pnpm clean:dist && NODE_OPTIONS=\"--import ./instrumentation.mjs${NODE_OPTIONS:+ $NODE_OPTIONS}\" node -r tsconfig-paths/register ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "pnpm clean:dist && NODE_OPTIONS=\"--import ./instrumentation.mjs${NODE_OPTIONS:+ $NODE_OPTIONS}\" node -r tsconfig-paths/register ./node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "NODE_OPTIONS=\"--import ./instrumentation.mjs${NODE_OPTIONS:+ $NODE_OPTIONS}\" node dist/src/bootstrap/index.js",
    "start:worker": "NODE_OPTIONS=\"--import ./instrumentation.mjs${NODE_OPTIONS:+ $NODE_OPTIONS}\" node -r tsconfig-paths/register ./node_modules/@nestjs/cli/bin/nest.js start --entryFile worker",
    "start:worker:dev": "pnpm clean:dist && NODE_OPTIONS=\"--import ./instrumentation.mjs${NODE_OPTIONS:+ $NODE_OPTIONS}\" node -r tsconfig-paths/register ./node_modules/@nestjs/cli/bin/nest.js start --watch --entryFile worker",
    "start:worker:prod": "NODE_OPTIONS=\"--import ./instrumentation.mjs${NODE_OPTIONS:+ $NODE_OPTIONS}\" node dist/src/bootstrap/worker.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:int": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest-int.json --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --watchman=false",
    "test:hurl": "hurl --test --glob \"api-tests/**/*.hurl\" --variables-file api-tests/hurl.variables",
    "test:chaos": "bash ./test/chaos/run-chaos-smoke.sh",
    "test:perf": "node ./test/performance/run-k6.mjs"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@infisical/cli": "^0.43.100",
    "@keyv/redis": "^5.1.6",
    "@mikro-orm/cli": "^6.6.14",
    "@mikro-orm/core": "^6.5.8",
    "@mikro-orm/migrations": "^6.6.14",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.5.8",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.66.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.206.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.206.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.6",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "keyv": "^5.6.0",
    "ms": "^2.1.3",
    "nestjs-cls": "^6.2.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dauphaihau/eslint-config": "^0.3.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.0.8",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^~/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
